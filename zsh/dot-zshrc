# Path to your Oh My Zsh installation.
export ZSH="$HOME/.oh-my-zsh"

# Set name of the theme to load.
# See https://github.com/ohmyzsh/ohmyzsh/wiki/Themes
ZSH_THEME="steeef"

# Disable marking untracked files under VCS as dirty.
DISABLE_UNTRACKED_FILES_DIRTY="true"

# Set the command execution timestamp shown in the history command output.
HIST_STAMPS="yyyy-mm-dd"

# Standard plugins can be found in $ZSH/plugins/
# Custom plugins may be added to $ZSH_CUSTOM/plugins/
plugins=(git autoupdate vi-mode zsh-autosuggestions zsh-syntax-highlighting)

source $ZSH/oh-my-zsh.sh

# User configuration
bindkey '^y' autosuggest-accept
bindkey '^p' history-search-backward
bindkey '^n' history-search-forward

setopt sharehistory

# Custom functions and hooks
function pexpr() {
    local expr=$@
    echo "$(uv run python -c "print($expr)")"
}

function activate_venv() {
    local venv_dir=".venv"

    if ! [[ -z "$VIRTUAL_ENV" ]] ; then
        if [[ "$PWD"/ != "$(dirname "$VIRTUAL_ENV")"/* ]] ; then
            deactivate
        fi
    fi
    if [[ -d "$PWD/$venv_dir" && -z "$VIRTUAL_ENV" ]] ; then
        source "$PWD/$venv_dir/bin/activate"
    fi
}
activate_venv

function activate_env() {
    local env_file=".env"

    if [[ -f "$PWD/$env_file" ]] ; then
        source "$PWD/$env_file"
    fi
}
activate_env

autoload -U add-zsh-hook
add-zsh-hook chpwd activate_venv
add-zsh-hook chpwd activate_env

# Welcome Message!
[[ -f "$HOME/.config/motd" ]] && zsh "$HOME/.config/motd"

